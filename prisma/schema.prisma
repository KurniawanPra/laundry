generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  RECEIVED
  QUEUED
  WASHING
  DRYING
  IRONING
  PACKAGED
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum ServiceUnit {
  PER_KG
  PER_PCS
  PER_M2
}

enum RateType {
  REGULAR
  EXPRESS
}

enum ProductionStage {
  WASHING
  DRYING
  IRONING
}

enum UserRole {
  OWNER
  CASHIER
  WASHER
}

enum ComplaintType {
  COLOR_BLEEDING
  LOST
  DAMAGED
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  address   String?  @db.Text
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id                 Int                    @id @default(autoincrement())
  name               String
  unit               String
  unitCode           ServiceUnit            @default(PER_KG)
  price              Int
  regularPrice       Int                    @default(0)
  expressPrice       Int                    @default(0)
  durationHrs        Int                    @default(48)
  expressDurationHrs Int                    @default(24)
  isActive           Boolean                @default(true)
  stages             ServiceWorkflowStage[]
  orderItems         OrderItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model LaundrySpeed {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  priceMultiplier   Float    @default(1)
  durationMultiplier Float  @default(1)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ServiceWorkflowStage {
  id        Int             @id @default(autoincrement())
  serviceId Int
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stage     ProductionStage
  position  Int

  @@unique([serviceId, stage])
  @@unique([serviceId, position])
}

model Order {
  id                 Int              @id @default(autoincrement())
  invoiceCode        String           @unique
  customerId         Int
  customer           Customer         @relation(fields: [customerId], references: [id])
  createdById        Int?
  createdBy          User?            @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: SetNull)
  status             OrderStatus      @default(RECEIVED)
  paymentStatus      PaymentStatus    @default(UNPAID)
  paymentMethod      String?
  totalAmount        Int
  notes              String?          @db.Text
  estimatedDone      DateTime?
  rackLocation       String?          @db.VarChar(32)
  pickedUpBy         String?          @db.VarChar(191)
  cancellationReason String?          @db.Text
  items              OrderItem[]
  payments           Payment[]
  statusLogs         OrderStatusLog[]
  complaints         Complaint[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, estimatedDone])
  @@index([createdAt])
}

model OrderItem {
  id             Int         @id @default(autoincrement())
  orderId        Int
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId      Int
  service        Service     @relation(fields: [serviceId], references: [id])
  serviceName    String      @default("")
  unitCode       ServiceUnit @default(PER_KG)
  rateType       RateType    @default(REGULAR)
  speedName      String      @default("Reguler")
  durationHrs    Int         @default(48)
  workflowStages String      @default("") @db.VarChar(64)
  quantity       Float
  price          Int
  subtotal       Int

  @@index([orderId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  staffId   Int?
  staff     User?         @relation("PaymentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([orderId, paidAt])
  @@index([paidAt, method])
}

model OrderStatusLog {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  isUndo     Boolean      @default(false)
  staffId    Int?
  staff      User?        @relation("StatusLogStaff", fields: [staffId], references: [id], onDelete: SetNull)
  changedAt  DateTime     @default(now())

  @@index([orderId, changedAt])
}

model Complaint {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        ComplaintType
  notes       String          @db.Text
  status      ComplaintStatus @default(OPEN)
  handledById Int?
  handledBy   User?           @relation("ComplaintHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId, status])
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean          @default(true)
  sessions      Session[]
  createdOrders Order[]          @relation("CreatedOrders")
  payments      Payment[]        @relation("PaymentStaff")
  statusLogs    OrderStatusLog[] @relation("StatusLogStaff")
  complaints    Complaint[]      @relation("ComplaintHandler")
  cashClosures  CashClosure[]    @relation("CashClosureStaff")
  settings      AppSetting[]     @relation("SettingUpdater")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CashClosure {
  id             Int      @id @default(autoincrement())
  businessDate   DateTime @db.Date
  staffId        Int
  staff          User     @relation("CashClosureStaff", fields: [staffId], references: [id])
  orderCount     Int
  cashTotal      Int
  transferTotal  Int
  qrisTotal      Int
  cashCounted    Int
  cashDifference Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  @@unique([businessDate, staffId])
  @@index([businessDate])
}

model AppSetting {
  key         String   @id
  value       String
  updatedById Int?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}
