generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum FeatureType {
  TOGGLE
  QUOTA
}

enum OrderStatus {
  RECEIVED
  QUEUED
  WASHING
  DRYING
  IRONING
  PACKAGED
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum ServiceUnit {
  PER_KG
  PER_PCS
  PER_M2
}

enum RateType {
  REGULAR
  EXPRESS
}

enum ProductionStage {
  WASHING
  DRYING
  IRONING
}

enum UserRole {
  SUPER_OWNER
  OWNER
  CASHIER
  WASHER
}

enum ComplaintType {
  COLOR_BLEEDING
  LOST
  DAMAGED
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Tenant {
  id           Int                      @id @default(autoincrement())
  name         String
  slug         String                   @unique
  status       TenantStatus             @default(TRIAL)
  trialEndsAt  DateTime?
  planId       Int?
  plan         SubscriptionPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  settings     String?                  @db.Text
  stores       Store[]
  users        User[]
  customers    Customer[]
  services     Service[]
  speeds       LaundrySpeed[]
  orders       Order[]
  orderItems   OrderItem[]
  payments     Payment[]
  statusLogs   OrderStatusLog[]
  complaints   Complaint[]
  cashClosures CashClosure[]
  settingsList AppSetting[]
  overrides    TenantFeatureOverride[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status])
  @@index([planId])
}

model SubscriptionPlan {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  price        Int           @default(0)
  billingCycle BillingCycle  @default(MONTHLY)
  isActive     Boolean       @default(true)
  tenants      Tenant[]
  features     PlanFeature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model FeatureDefinition {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  name         String
  type         FeatureType
  defaultValue String      @default("false")
  createdAt    DateTime    @default(now())
}

model PlanFeature {
  id          Int              @id @default(autoincrement())
  planId      Int
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureCode String
  value       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([planId, featureCode])
  @@index([planId])
}

model TenantFeatureOverride {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureCode String
  value       String
  reason      String    @db.Text
  expiresAt   DateTime?
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, featureCode])
  @@index([tenantId])
}

model Store {
  id          Int            @id @default(autoincrement())
  tenantId    Int?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  address     String?        @db.Text
  phone       String?
  isActive    Boolean        @default(true)
  ownerId     Int?
  owner       User?          @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  users       StoreUser[]
  orders      Order[]
  customers   Customer[]
  services    Service[]
  speeds      LaundrySpeed[]
  closures    CashClosure[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model StoreUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  storeId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role      UserRole

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  tenantId  Int?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  address   String?  @db.Text
  storeId   Int?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([storeId])
}

model Service {
  id                 Int                    @id @default(autoincrement())
  tenantId           Int?
  tenant             Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  unit               String
  unitCode           ServiceUnit            @default(PER_KG)
  price              Int
  regularPrice       Int                    @default(0)
  expressPrice       Int                    @default(0)
  durationHrs        Int                    @default(48)
  expressDurationHrs Int                    @default(24)
  isActive           Boolean                @default(true)
  storeId            Int?
  store              Store?                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stages             ServiceWorkflowStage[]
  orderItems         OrderItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([tenantId])
  @@index([storeId])
}

model LaundrySpeed {
  id                 Int      @id @default(autoincrement())
  tenantId           Int?
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  priceMultiplier    Float    @default(1)
  durationMultiplier Float    @default(1)
  isActive           Boolean  @default(true)
  storeId            Int?
  store              Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([storeId])
}

model ServiceWorkflowStage {
  id        Int             @id @default(autoincrement())
  serviceId Int
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stage     ProductionStage
  position  Int

  @@unique([serviceId, stage])
  @@unique([serviceId, position])
}

model Order {
  id                 Int              @id @default(autoincrement())
  tenantId           Int?
  tenant             Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceCode        String
  storeId            Int?
  store              Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customerId         Int
  customer           Customer         @relation(fields: [customerId], references: [id])
  createdById        Int?
  createdBy          User?            @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: SetNull)
  status             OrderStatus      @default(RECEIVED)
  paymentStatus      PaymentStatus    @default(UNPAID)
  paymentMethod      String?
  totalAmount        Int
  notes              String?          @db.Text
  estimatedDone      DateTime?
  rackLocation       String?          @db.VarChar(32)
  pickedUpBy         String?          @db.VarChar(191)
  cancellationReason String?          @db.Text
  items              OrderItem[]
  payments           Payment[]
  statusLogs         OrderStatusLog[]
  complaints         Complaint[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tenantId, invoiceCode])
  @@index([tenantId])
  @@index([storeId])
  @@index([status, estimatedDone])
  @@index([createdAt])
}

model OrderItem {
  id             Int         @id @default(autoincrement())
  tenantId       Int?
  tenant         Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId        Int
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId      Int
  service        Service     @relation(fields: [serviceId], references: [id])
  serviceName    String      @default("")
  unitCode       ServiceUnit @default(PER_KG)
  rateType       RateType    @default(REGULAR)
  speedName      String      @default("Reguler")
  durationHrs    Int         @default(48)
  workflowStages String      @default("") @db.VarChar(64)
  quantity       Float
  price          Int
  subtotal       Int

  @@index([tenantId])
  @@index([orderId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  tenantId  Int?
  tenant    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   Int
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  staffId   Int?
  staff     User?         @relation("PaymentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([tenantId])
  @@index([orderId, paidAt])
  @@index([paidAt, method])
}

model OrderStatusLog {
  id         Int          @id @default(autoincrement())
  tenantId   Int?
  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  isUndo     Boolean      @default(false)
  staffId    Int?
  staff      User?        @relation("StatusLogStaff", fields: [staffId], references: [id], onDelete: SetNull)
  changedAt  DateTime     @default(now())

  @@index([tenantId])
  @@index([orderId, changedAt])
}

model Complaint {
  id          Int             @id @default(autoincrement())
  tenantId    Int?
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        ComplaintType
  notes       String          @db.Text
  status      ComplaintStatus @default(OPEN)
  handledById Int?
  handledBy   User?           @relation("ComplaintHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@index([orderId, status])
}

model User {
  id               Int              @id @default(autoincrement())
  tenantId         Int?
  tenant           Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name             String
  email            String           @unique
  passwordHash     String
  role             UserRole
  isActive         Boolean          @default(true)
  ownedStores      Store[]          @relation("StoreOwner")
  storeMemberships StoreUser[]
  sessions         Session[]
  createdOrders    Order[]          @relation("CreatedOrders")
  payments         Payment[]        @relation("PaymentStaff")
  statusLogs       OrderStatusLog[] @relation("StatusLogStaff")
  complaints       Complaint[]      @relation("ComplaintHandler")
  cashClosures     CashClosure[]    @relation("CashClosureStaff")
  settings         AppSetting[]     @relation("SettingUpdater")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CashClosure {
  id             Int      @id @default(autoincrement())
  tenantId       Int?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessDate   DateTime @db.Date
  storeId        Int?
  store          Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffId        Int
  staff          User     @relation("CashClosureStaff", fields: [staffId], references: [id])
  orderCount     Int
  cashTotal      Int
  transferTotal  Int
  qrisTotal      Int
  cashCounted    Int
  cashDifference Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  @@unique([businessDate, staffId])
  @@index([tenantId])
  @@index([storeId])
  @@index([businessDate])
}

model AppSetting {
  id          Int      @id @default(autoincrement())
  tenantId    Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  value       String
  updatedById Int?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}
